# CharlesGPT — local configuration
# Copy to backend/.env and adjust as needed.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Paths (absolute or relative to project root)
# Empty = project root (Year1–Year4 + Projects) for local use
# Public demo / GitHub clone: DOCUMENTS_PATH=demo_corpus
DOCUMENTS_PATH=
SQLITE_PATH=data/sqlite/second_brain.db
QDRANT_PATH=data/qdrant

# Chunking (approximate tokens; ~4 chars ≈ 1 token)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval
TOP_K=8

# Free DuckDuckGo Instant Answer (no API key). Set false to disable.
WEB_LOOKUP_ENABLED=true
# Used when someone asks "what's the weather" without a city
DEFAULT_WEATHER_LOCATION=Dublin

# Local OCR for PNG/JPEG/WebP and scanned PDF pages (RapidOCR + onnxruntime)
OCR_ENABLED=true
OCR_PDF_FALLBACK=true
# OCR_PDF_ZOOM=2.0
# OCR_MIN_IMAGE_SIDE=64
# OCR_MAX_FILE_MB=25

# Server (local-only by default)
HOST=127.0.0.1
PORT=8000

# Qdrant collection
QDRANT_COLLECTION=college_chunks
