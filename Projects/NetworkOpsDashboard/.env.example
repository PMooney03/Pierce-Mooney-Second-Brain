# Copy to .env for local overrides (never commit .env).
# Defaults below match docker-compose.yml and application-dev.yml.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

POSTGRES_DB=networkops
POSTGRES_USER=networkops
POSTGRES_PASSWORD=networkops
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/networkops
DATABASE_USERNAME=networkops
DATABASE_PASSWORD=networkops

STATUS_CHECK_INTERVAL_MS=30000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
