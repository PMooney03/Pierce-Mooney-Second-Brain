*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

# Allow loopback
-A INPUT -i lo -j ACCEPT

# Allow established connections
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

# Allow ICMP
-A INPUT -p icmp -j ACCEPT

# Allow SSH from internal network
-A INPUT -p tcp --dport 22 -s {{ network_subnet }} -j ACCEPT

# Allow Samba services
-A INPUT -p tcp --dport 139 -s {{ network_subnet }} -j ACCEPT
-A INPUT -p tcp --dport 445 -s {{ network_subnet }} -j ACCEPT
-A INPUT -p udp --dport 137 -s {{ network_subnet }} -j ACCEPT
-A INPUT -p udp --dport 138 -s {{ network_subnet }} -j ACCEPT

# Allow DNS
-A INPUT -p tcp --dport 53 -s {{ network_subnet }} -j ACCEPT
-A INPUT -p udp --dport 53 -s {{ network_subnet }} -j ACCEPT

# Allow AD/DC core ports (required for DC replication and domain join)
-A INPUT -p tcp --dport 88 -j ACCEPT
-A INPUT -p udp --dport 88 -j ACCEPT
-A INPUT -p tcp --dport 135 -j ACCEPT
-A INPUT -p tcp --dport 389 -j ACCEPT
-A INPUT -p udp --dport 389 -j ACCEPT
-A INPUT -p tcp --dport 445 -j ACCEPT
-A INPUT -p tcp --dport 464 -j ACCEPT
-A INPUT -p udp --dport 464 -j ACCEPT
-A INPUT -p tcp --dport 636 -j ACCEPT
-A INPUT -p tcp --dport 3268 -j ACCEPT
-A INPUT -p tcp --dport 3269 -j ACCEPT

# Allow Squid proxy
-A INPUT -p tcp --dport 3128 -s {{ network_subnet }} -j ACCEPT
-A INPUT -p tcp --dport 8080 -s {{ network_subnet }} -j ACCEPT

# Allow HTTP/HTTPS for gateway status
-A INPUT -p tcp --dport 80 -s {{ network_subnet }} -j ACCEPT
-A INPUT -p tcp --dport 443 -s {{ network_subnet }} -j ACCEPT

# Forward rules for gateway functionality
-A FORWARD -s {{ network_subnet }} -d {{ network_subnet }} -j ACCEPT
-A FORWARD -s {{ network_subnet }} -o eth0 -j ACCEPT
-A FORWARD -i eth0 -s 0.0.0.0/0 -d {{ network_subnet }} -m state --state ESTABLISHED,RELATED -j ACCEPT

# Default policies
-A INPUT -j DROP
-A FORWARD -j DROP

