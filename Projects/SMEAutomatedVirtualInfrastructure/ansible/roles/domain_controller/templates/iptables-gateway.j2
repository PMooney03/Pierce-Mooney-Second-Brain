# Domain Controller Gateway Configuration

*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]

# NAT for internal network through this DC
-A POSTROUTING -s {{ network_subnet }} -o eth0 -j MASQUERADE

# Transparent proxy for HTTP traffic
-A PREROUTING -i eth1 -p tcp --dport 80 -j REDIRECT --to-port 3128
-A PREROUTING -i eth1 -p tcp --dport 443 -j REDIRECT --to-port 3128

