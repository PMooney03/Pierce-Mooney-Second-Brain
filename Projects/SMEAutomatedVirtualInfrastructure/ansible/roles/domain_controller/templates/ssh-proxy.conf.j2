# SSH Proxy Configuration for SME Domain Controller
# This allows SSH access to be routed through DC boxes for centralized control

# SSH Proxy Service Configuration
Port 2222
Protocol 2
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Authentication
PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

# Allow forwarding to internal hosts
AllowTcpForwarding yes
GatewayPorts yes
PermitTunnel yes

# Logging
LogLevel INFO
SyslogFacility AUTH

# Access control
AllowUsers sme-admin vagrant
AllowGroups sudo

# Security settings
MaxAuthTries 3
MaxSessions 10
ClientAliveInterval 300
ClientAliveCountMax 3

# Bind to this host's configured internal IP from inventory
ListenAddress {{ ansible_host }}

# Subsystem for sftp
Subsystem sftp /usr/lib/openssh/sftp-server 