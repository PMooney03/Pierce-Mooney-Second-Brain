# enterprise-pentest-lab environment variables
# Copy to .env for local overrides (optional)

# Enable Prometheus + Grafana during setup
ENABLE_MONITORING=true

# Skip Vagrant provisioning (Docker-only testing)
SKIP_VAGRANT=false

# Use full Windows Server eval VM instead of Linux placeholder
ENABLE_WINDOWS_VM=false

# Force destroy without confirmation prompt
FORCE=false

# Override VirtualBox host-only gateway (auto-detected if unset)
# LAB_HOST_GATEWAY=192.168.56.254
