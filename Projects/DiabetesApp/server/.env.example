# App URL — used in verification email links (Tailscale HTTPS URL for phone access)
# Run "tailscale serve 3001" then set to your https://your-pc.tail-xxxxx.ts.net URL
# Or run "npm run setup" to auto-detect from Tailscale
APP_URL=https://your-pc-name.tail-xxxxx.ts.net

# Secret for login tokens — run "npm run setup" to generate a random value
JWT_SECRET=change-this-to-a-long-random-string

# Email sending — FREE with Gmail (ONE-TIME admin setup, not per user)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
# Get a Gmail app password: https://myaccount.google.com/apppasswords (requires 2FA)
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=your@gmail.com

# Optional: restrict who can register (comma-separated).
# Leave blank or commented out so ANY user can self-register and verify by email.
# ALLOWED_EMAILS=dad@gmail.com,you@gmail.com
